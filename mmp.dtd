<?xml version="1.0" encoding="UTF-8"?>

<!-- ================================================== -->
<!-- MMP DTD - Equivalent to mmp.xsd                    -->
<!-- Revision 2: additions only, all optional (see the  -->
<!-- comment at the top of mmp.xsd).                    -->
<!-- ================================================== -->

<!-- Root Element -->
<!ELEMENT POLYGONS (GROUPS?, POLYGON*, SPOT*, IMAGELAYER*, LAYER*, PROJECT?)>
<!ATTLIST POLYGONS
    creator CDATA #IMPLIED
    date CDATA #IMPLIED
    project CDATA #IMPLIED
    id CDATA #IMPLIED
    projectId CDATA #IMPLIED
    projectName CDATA #IMPLIED
>

<!-- ================================================== -->
<!-- GROUPS Structure                                   -->
<!-- ================================================== -->

<!ELEMENT GROUPS (GROUP*)>

<!ELEMENT GROUP (ID, NAME, DESCRIPTION, GROUPCOLOR, GROUPCUSTOMCOLOR?, SHOWBOUNDS?)>
<!ATTLIST GROUP id CDATA #IMPLIED>
<!ELEMENT ID (#PCDATA)>
<!ELEMENT NAME (#PCDATA)>
<!ELEMENT DESCRIPTION (#PCDATA)>
<!ELEMENT GROUPCOLOR (#PCDATA)> <!-- Integer 0-7 -->
<!ELEMENT GROUPCUSTOMCOLOR (#PCDATA)> <!-- Hex color -->
<!ELEMENT SHOWBOUNDS (#PCDATA)> <!-- BinaryFlag: 0 or 1 (revision 2) -->

<!-- ================================================== -->
<!-- POLYGON Structure                                  -->
<!-- ================================================== -->

<!ELEMENT POLYGON (GROUPID?, NAME, DESCRIPTION, ISHOLE, BLOCKED, SHAPE, NOSURFACE, SHOWPINS, SHOWDISTANCES, LINECOLOR, LINECUSTOMCOLOR?, LINEWIDTH, LINESTYLE, AREACOLOR, AREACUSTOMCOLOR?, AREATRANSPARENCY, SHOWNAME, SHOWLABELBACKGROUND, SHOWAREAMEASURE, SHOWPERIMETERMEASURE, COORDINATEPOLYGONLABELLATITUDE, COORDINATEPOLYGONLABELLONGITUDE, COORDINATEPERIMETERLABELLATITUDE, COORDINATEPERIMETERLABELLONGITUDE, COORDINATEAREALABELLATITUDE, COORDINATEAREALABELLONGITUDE, GRID?, FILLOPACITY?, LINEWIDTHPX?, LINESTYLENAME?, SHOWPINSWHENUNLOCKED?, SHOWPRICELABEL?, ISBUFFER?, PARENTID?, PRODUCTID?, TEXTUREROTATION?, ALTITUDEMODE3D?, ALTITUDE3D?, EXTRUDED3D?, TITLELABELMANUAL?, PARCELPROVIDERID?, PARCELREFERENCE?, PARCELEXTRAINFO?, PICTURES?, POINTS?)>
<!ATTLIST POLYGON id CDATA #IMPLIED>

<!ELEMENT GROUPID (#PCDATA)>
<!ELEMENT ISHOLE (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->
<!ELEMENT BLOCKED (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->
<!ELEMENT SHAPE (#PCDATA)> <!-- Integer: 0=polygon, 1=circle, 2=rectangle -->
<!ELEMENT NOSURFACE (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->
<!ELEMENT SHOWPINS (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->
<!ELEMENT SHOWDISTANCES (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->
<!ELEMENT LINECOLOR (#PCDATA)> <!-- Integer 0-6 -->
<!ELEMENT LINECUSTOMCOLOR (#PCDATA)> <!-- Hex color -->
<!ELEMENT LINEWIDTH (#PCDATA)> <!-- Integer 0-10 -->
<!ELEMENT LINESTYLE (#PCDATA)> <!-- Integer 0-5 (5 = dash-dot) -->
<!ELEMENT AREACOLOR (#PCDATA)> <!-- Integer 0-6 -->
<!ELEMENT AREACUSTOMCOLOR (#PCDATA)> <!-- Hex color -->
<!ELEMENT AREATRANSPARENCY (#PCDATA)> <!-- Integer 0-10 (0 = opaque) -->
<!ELEMENT SHOWNAME (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->
<!ELEMENT SHOWLABELBACKGROUND (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->
<!ELEMENT SHOWAREAMEASURE (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->
<!ELEMENT SHOWPERIMETERMEASURE (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->
<!ELEMENT COORDINATEPOLYGONLABELLATITUDE (#PCDATA)> <!-- Latitude: -90 to 90 -->
<!ELEMENT COORDINATEPOLYGONLABELLONGITUDE (#PCDATA)> <!-- Longitude: -180 to 180 -->
<!ELEMENT COORDINATEPERIMETERLABELLATITUDE (#PCDATA)> <!-- Latitude: -90 to 90 -->
<!ELEMENT COORDINATEPERIMETERLABELLONGITUDE (#PCDATA)> <!-- Longitude: -180 to 180 -->
<!ELEMENT COORDINATEAREALABELLATITUDE (#PCDATA)> <!-- Latitude: -90 to 90 -->
<!ELEMENT COORDINATEAREALABELLONGITUDE (#PCDATA)> <!-- Longitude: -180 to 180 -->

<!-- Revision 2: exact values beside the rounded ones above, and more -->
<!ELEMENT FILLOPACITY (#PCDATA)> <!-- Float 0.0-1.0 -->
<!ELEMENT LINEWIDTHPX (#PCDATA)> <!-- Float -->
<!ELEMENT LINESTYLENAME (#PCDATA)> <!-- solid | dashed | dotted | dashed_filled | dotted_filled | dash_dot | dash_dot_dot | dash_dash_dot -->
<!ELEMENT SHOWPINSWHENUNLOCKED (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->
<!ELEMENT SHOWPRICELABEL (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->
<!ELEMENT ISBUFFER (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->
<!ELEMENT PARENTID (#PCDATA)>
<!ELEMENT PRODUCTID (#PCDATA)>
<!ELEMENT TEXTUREROTATION (#PCDATA)> <!-- Float -->
<!ELEMENT ALTITUDEMODE3D (#PCDATA)>
<!ELEMENT ALTITUDE3D (#PCDATA)> <!-- Float -->
<!ELEMENT EXTRUDED3D (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->
<!ELEMENT PARCELPROVIDERID (#PCDATA)>
<!ELEMENT PARCELREFERENCE (#PCDATA)>
<!ELEMENT PARCELEXTRAINFO (#PCDATA)>
<!ELEMENT TITLELABELMANUAL (#PCDATA)>

<!-- ================================================== -->
<!-- GRID Structure                                     -->
<!-- ================================================== -->

<!ELEMENT GRID (CELLWIDTH, CELLHEIGHT, BEARING, REFLATITUDE, REFLONGITUDE, SHOWGRID)>
<!ELEMENT CELLWIDTH (#PCDATA)> <!-- Float -->
<!ELEMENT CELLHEIGHT (#PCDATA)> <!-- Float -->
<!ELEMENT BEARING (#PCDATA)> <!-- Float -->
<!ELEMENT REFLATITUDE (#PCDATA)> <!-- Latitude: -90 to 90 -->
<!ELEMENT REFLONGITUDE (#PCDATA)> <!-- Longitude: -180 to 180 -->
<!ELEMENT SHOWGRID (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->

<!-- ================================================== -->
<!-- PICTURES Structure                                 -->
<!-- ================================================== -->

<!ELEMENT PICTURES (PICTURE*)>

<!ELEMENT PICTURE (DATE?, PICTUREURL, PICTURETHUMBNAILURL?, SHOWPICTINREPORT?)>
<!ELEMENT DATE (#PCDATA)> <!-- ISO 8601 date string -->
<!ELEMENT PICTUREURL (#PCDATA)>
<!ELEMENT PICTURETHUMBNAILURL (#PCDATA)>
<!ELEMENT SHOWPICTINREPORT (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->

<!-- ================================================== -->
<!-- POINTS Structure                                   -->
<!-- ================================================== -->

<!ELEMENT POINTS (POINT*)>

<!ELEMENT POINT (LAT, LONG, ALT?, DESCPOINT?, ALT3D?, PICTURES?)>
<!ATTLIST POINT id CDATA #IMPLIED>
<!ELEMENT LAT (#PCDATA)> <!-- Float -->
<!ELEMENT LONG (#PCDATA)> <!-- Float -->
<!ELEMENT ALT (#PCDATA)> <!-- Float -->
<!ELEMENT ALT3D (#PCDATA)> <!-- Float (revision 2) -->

<!ELEMENT DESCPOINT (SHOWDESC?, SHOWLABELBACKGROUND?, SHOWDESCINREPORT?, DESC, DESCLAT, DESCLONG)>
<!ELEMENT SHOWDESC (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->
<!ELEMENT SHOWDESCINREPORT (#PCDATA)> <!-- BinaryFlag: 0 or 1 -->
<!ELEMENT DESC (#PCDATA)>
<!ELEMENT DESCLAT (#PCDATA)> <!-- Float -->
<!ELEMENT DESCLONG (#PCDATA)> <!-- Float -->

<!-- ================================================== -->
<!-- SPOT Structure                                     -->
<!-- ================================================== -->

<!ELEMENT SPOT (GROUPID?, NAME, SHOWNAME, SHOWLABELBACKGROUND, ICON, SPOTICONCOLOR, SPOTICONCUSTOMCOLOR?, LAT, LONG, ALT?, PICTURES?, COORDINATESPOTNAMELATITUDE, COORDINATESPOTNAMELONGITUDE, DESCSPOT?, ALT3D?, PRODUCTID?)>
<!ATTLIST SPOT id CDATA #IMPLIED>

<!ELEMENT ICON (#PCDATA)> <!-- Integer -->
<!ELEMENT SPOTICONCOLOR (#PCDATA)> <!-- Integer 0-7 -->
<!ELEMENT SPOTICONCUSTOMCOLOR (#PCDATA)> <!-- Hex color -->
<!ELEMENT COORDINATESPOTNAMELATITUDE (#PCDATA)> <!-- Float -->
<!ELEMENT COORDINATESPOTNAMELONGITUDE (#PCDATA)> <!-- Float -->

<!ELEMENT DESCSPOT (SHOWDESC?, SHOWDESCINREPORT?, DESC?)>

<!-- ================================================== -->
<!-- IMAGELAYER Structure                               -->
<!-- ================================================== -->

<!ELEMENT IMAGELAYER (NAME, IMAGEURL?, OPACITY, LAT1, LONG1, LAT2, LONG2)>
<!ELEMENT IMAGEURL (#PCDATA)>
<!ELEMENT OPACITY (#PCDATA)> <!-- Float 0.0-1.0 -->
<!ELEMENT LAT1 (#PCDATA)> <!-- Float -->
<!ELEMENT LONG1 (#PCDATA)> <!-- Float -->
<!ELEMENT LAT2 (#PCDATA)> <!-- Float -->
<!ELEMENT LONG2 (#PCDATA)> <!-- Float -->

<!-- ================================================== -->
<!-- LAYER Structure (revision 2)                       -->
<!-- Layers an IMAGELAYER cannot describe               -->
<!-- ================================================== -->

<!ELEMENT LAYER (NAME, URL, OPACITY?, LAT1?, LONG1?, LAT2?, LONG2?, FEATURECOUNT?)>
<!ATTLIST LAYER type (image_overlay | mbtiles | vector) #REQUIRED>
<!ELEMENT URL (#PCDATA)>
<!ELEMENT FEATURECOUNT (#PCDATA)> <!-- Integer -->

<!-- ================================================== -->
<!-- PROJECT Structure (revision 2)                     -->
<!-- Settings that travel with the file                 -->
<!-- ================================================== -->

<!ELEMENT PROJECT (TAXRATE?, CLIENTNAME?, DEFAULTPRODUCTID?)>
<!ELEMENT TAXRATE (#PCDATA)> <!-- Float -->
<!ELEMENT CLIENTNAME (#PCDATA)>
<!ELEMENT DEFAULTPRODUCTID (#PCDATA)>
